limit_req_zone $binary_remote_addr zone=qnh_login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=qnh_api:10m rate=60r/m;

server {
    listen 443 ssl http2;
    server_name hyperfield.example.com;

    ssl_certificate     /etc/letsencrypt/live/hyperfield.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hyperfield.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 2m;

    location = /login {
        limit_req zone=qnh_login burst=3 nodelay;
        proxy_pass http://127.0.0.1:8080;
        include /etc/nginx/proxy_params;
    }

    location /api/ {
        limit_req zone=qnh_api burst=30 nodelay;
        proxy_pass http://127.0.0.1:8080;
        include /etc/nginx/proxy_params;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        include /etc/nginx/proxy_params;
    }
}
