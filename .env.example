# Copy to .env and fill values. Do not commit .env.
QNH_ADMIN_USER=admin
# Generate with: docker compose run --rm app python qnhctl.py hash-password
QNH_ADMIN_PASSWORD_HASH=
# Alternative bootstrap only; prefer the Argon2 hash above.
QNH_BOOTSTRAP_ADMIN_PASSWORD=

# Flask secret can instead use QNH_SECRET_KEY_FILE=/run/secrets/flask_secret_key
QNH_SECRET_KEY=
QNH_COOKIE_SECURE=0
QNH_HSTS=0
QNH_TRUST_PROXY=0

QNH_BIND_ADDR=127.0.0.1
QNH_PORT=8080
QNH_MEMORY_LIMIT=1536m
QNH_CPU_LIMIT=2.0

OPENAI_API_KEY=
# Optional: OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
QNH_OPENAI_EMBED_MODEL=text-embedding-3-large
QNH_OPENAI_EMBED_DIM=3072

# Weaviate is internal-only and anonymous by default in compose.yaml.
# For a multi-tenant deployment, enable Weaviate auth and configure this.
WEAVIATE_API_KEY=

# Optional local Contriever. Requires requirements-ml.txt in a custom image.
QNH_ENABLE_CONTRIEVER=0
QNH_FB_MODEL=facebook/contriever-msmarco
QNH_FB_REVISION=287db3b2d7662e688c051c351a0739de4ef2d6d7
QNH_HF_OFFLINE=0

# Optional structured Responses analysis. Model is deliberately operator-configured.
QNH_REASONING_MODEL=
QNH_REASONING_EFFORT=high

# Gemma integrity/download layer. Multi-GB download remains disabled by default.
QNH_ALLOW_MODEL_DOWNLOADS=0
QNH_GEMMA_SHA256=ab7838cdfc8f77e54d8ca45eadceb20452d9f01e4bfade03e5dce27911b27e42
